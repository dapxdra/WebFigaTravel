# Copy this file to .env and fill in your real Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Maps browser key (Places autocomplete). Restrict it by HTTP referrer
# and to "Places API (New)". Route distance/pricing uses a separate server key
# set as the GOOGLE_MAPS_SERVER_API_KEY Supabase Edge Function secret.
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
